# Gmail account the contact form sends from (use a Google App Password, not your normal password)
EMAIL_USER=
EMAIL_PASS=
# Where contact form messages are delivered (defaults to emmanuelchibuikeudorie@gmail.com)
CONTACT_TO_EMAIL=
# Public site URL, used for canonical links, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://ebubeudorie.com

# Supabase (Database & Storage for Admin CRUD, CV & Image uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio
# Admin login at /admin. Use ADMIN_PASSWORD_HASH (bcrypt, `npm run admin:hash -- yourpassword`) in production
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters used to sign the admin session
ADMIN_SESSION_SECRET=
# Cloudinary, for images and the CV uploaded from admin
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional salt for hashing visitor IPs in analytics
ANALYTICS_SALT=
